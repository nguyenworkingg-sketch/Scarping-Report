# Copy this file to .env on YOUR PC only. Never commit .env.

HSC_EMAIL=your_hsc_email_or_username
HSC_PASSWORD=your_hsc_password

VIETCAP_USERNAME=your_vietcap_username
VIETCAP_PASSWORD=your_vietcap_password

# Offline storage on your Windows PC
REPORT_ROOT=E:\\Báo cáo

# Delete downloaded report artifacts older than this many days
RETENTION_DAYS=30

# Browser settings
HEADLESS=true
MAX_REPORTS=30
